# Copy to .env and fill in. Never commit .env.
# Leave ANTHROPIC_API_KEY empty to run offline with the extractive fallback.
ANTHROPIC_API_KEY=

# auto = Claude if ANTHROPIC_API_KEY is set, otherwise extractive. Or force: claude | extractive
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
INDEX_DIR=storage/index
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_SCORE=0.58
